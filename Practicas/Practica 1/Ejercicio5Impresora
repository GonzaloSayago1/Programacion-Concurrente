D)Modifique la solución de (b) para el caso en que además hay un proceso Coordinador que le indica a cada persona que es su turno de usar la impresora.
int Actual = -1;
bool Terminado = false;
cola Q;

process Persona[id; 0..N-1]
{
 //Llega y se pone en la cola
 <Push(Q, id)>

 //Espera que lo llamen
 Imprimir(documento)

 //Le avisa al Coordinador que ya terminó de imprimir
 Terminado = true;
}

process Coordinador
{
 for [i = 1 to N]
    {
        // Espera a que haya alguien en la cola y lo saca atómicamente
        <await (not empty(Q)); Actual = Pop(Q);>

        // Espera a que la persona termine su impresión
        <await (Terminado); Terminado = false;>
    }
}
